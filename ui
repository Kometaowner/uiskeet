		WmText.Text = richStr
		local bounds = TextService:GetTextSize(plainStr .. "ull", 12, Enum.Font.Code, Vector2.new(1000, 100))
		WatermarkCanvas.Size = UDim2.fromOffset(bounds.X + 24, 28)
	end

