	local function SwitchTab(targetIndex)
		if TabSwitching or targetIndex == CurrentTabIndex or not Tabs[targetIndex] then return end
		TabSwitching = true
		CloseActivePopups()
		PlaySound(1.0)

		local prevIndex = CurrentTabIndex
		local direction = (targetIndex > prevIndex) and 1 or -1

		local oldTab = Tabs[prevIndex]
		local newTab = Tabs[targetIndex]
		CurrentTabIndex = targetIndex

		Tween(ActiveSlot, TweenInfo.new(0.38, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
			Position = UDim2.fromOffset(0, 18 + (targetIndex - 1) * SLOT_STEP)
		})

		Tween(oldTab.Icon, TweenInfo.new(0.24, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Position = UDim2.new(0.5, 0, 0.5, -direction * 12),
			Size = UDim2.fromOffset(ICON_INACTIVE_SIZE, ICON_INACTIVE_SIZE),
			ImageTransparency = 0.55
		})
		Tween(oldTab.Glow, TweenInfo.new(0.24), { ImageTransparency = 1 })

		task.delay(0.14, function()
			Tween(oldTab.Icon, TweenInfo.new(0.24, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
				Position = UDim2.fromScale(0.5, 0.5)
			})
		end)

		newTab.Icon.Position = UDim2.new(0.5, 0, 0.5, direction * 16)
		Tween(newTab.Icon, TweenInfo.new(0.38, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(ICON_ACTIVE_SIZE, ICON_ACTIVE_SIZE),
			ImageTransparency = 0
		})
		Tween(newTab.Glow, TweenInfo.new(0.35), { ImageTransparency = 0.86 })

		newTab.Page.Position = UDim2.fromScale(0, direction)
		newTab.Page.Visible = true

		local pageSwipeInfo = TweenInfo.new(0.42, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
		Tween(oldTab.Page, pageSwipeInfo, { Position = UDim2.fromScale(0, -direction) })
		local finishTw = Tween(newTab.Page, pageSwipeInfo, { Position = UDim2.fromScale(0, 0) })

		if OnTabSwitchedCallbacks[targetIndex] then
			task.spawn(OnTabSwitchedCallbacks[targetIndex])
		end

		finishTw.Completed:Wait()
		oldTab.Page.Visible = false
		TabSwitching = false
	end

