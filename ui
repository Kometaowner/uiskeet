	local function RefreshWatermarkText()
		local pingValue = 0
		pcall(function() pingValue = math.round(Stats.Network.ServerStatsItem["Data Ping"]:GetValue()) end)
		if pingValue <= 0 then pingValue = math.round(LocalPlayer:GetNetworkPing() * 1000) end

		local timeStr = os.date("%H:%M:%S")
		local nickStr = LocalPlayer.Name:lower()

		local plainStr = string.format("N | %s | delay: %dms | %d fps | %s", nickStr, pingValue, currentFpsValue, timeStr)
		local richStr = string.format(
			'<font color="#9FCA2B"><b>N</b></font><font color="#959595">ull</font> <font color="#4A4A4A">|</font> <font color="#DEDEDE">%s</font> <font color="#4A4A4A">|</font> <font color="#B8B8B8">delay: </font><font color="#9FCA2B">%dms</font> <font color="#4A4A4A">|</font> <font color="#DEDEDE">%d fps</font> <font color="#4A4A4A">|</font> <font color="#B8B8B8">%s</font>',
