					Tween(Title, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { TextColor3 = state and Theme.TextMain or Theme.TextInactive })
					SyncToHotkeys()
					if callback then task.spawn(callback, state) end
				end

				local function SetBind(newKeyCode, newMode)
					boundKey = newKeyCode
					bindMode = newMode or bindMode
					BindBtn.Text = boundKey and ("[" .. boundKey.Name:upper():sub(1, 3) .. "]") or "[-]"
					SyncToHotkeys()
				end

				if boundKey then SyncToHotkeys() end

				ClickZone.MouseButton1Down:Connect(function() isInteractingWithControl = true end)
				ClickZone.MouseButton1Click:Connect(function() CloseActivePopups(); SetState(not state, false) end)

				BindBtn.MouseButton1Down:Connect(function() isInteractingWithControl = true end)
				BindBtn.MouseButton1Click:Connect(function()
					CloseActivePopups()
					PlaySound(1.1)
					listeningForKey = true
					BindBtn.Text = "[...]"
					BindBtn.TextColor3 = Theme.Accent
				end)

				BindBtn.MouseButton2Click:Connect(function()
					OpenBindModePopup(BindBtn, bindMode, function(selectedMode)
						bindMode = selectedMode
						if bindMode == "Always on" then SetState(true, false) end
					end)
				end)

				UserInputService.InputBegan:Connect(function(input, gp)
					if listeningForKey then
						if input.UserInputType == Enum.UserInputType.Keyboard then
							if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.Backspace then
								SetBind(nil, bindMode)
							else
								SetBind(input.KeyCode, bindMode)
							end
							BindBtn.TextColor3 = Theme.TextDim
							listeningForKey = false
						end
					elseif not gp and boundKey and input.KeyCode == boundKey then
						if bindMode == "Toggle" then SetState(not state, false)
						elseif bindMode == "On hotkey" then SetState(true, false)
						elseif bindMode == "Off hotkey" then SetState(false, false) end
					end
				end)

				UserInputService.InputEnded:Connect(function(input, gp)
					if not gp and boundKey and input.KeyCode == boundKey then
						if bindMode == "On hotkey" then SetState(false, true)
						elseif bindMode == "Off hotkey" then SetState(true, true) end
					end
				end)

				NullLibrary.Registry[flagId] = {
					Type = "Toggle",
					Get = function() return { State = state, Key = boundKey and boundKey.Name or nil, Mode = bindMode } end,
					Set = function(data) SetBind(data.Key and Enum.KeyCode[data.Key] or nil, data.Mode or "Toggle"); SetState(data.State == true, true) end,
					Reset = function() SetBind(defaultKey, "Toggle"); SetState(defaultState or false, true) end
				}
			end

			function GroupAPI:AddSlider(flagId, labelText, minVal, maxVal, defaultVal, suffix, callback)
				suffix = suffix or ""
				local value = math.clamp(defaultVal or minVal, minVal, maxVal)
				local isHovered = false
				NullLibrary.Flags[flagId] = value

				local Holder = Instance.new("Frame")
				Holder.Size = UDim2.new(1, 0, 0, 36)
				Holder.BackgroundTransparency = 1
				Holder.Parent = ContentList

				local Title = Instance.new("TextLabel")
				Title.Size = UDim2.new(1, -22, 0, 15)
				Title.Position = UDim2.fromOffset(22, 0)
				Title.BackgroundTransparency = 1
				Title.Font = Enum.Font.Gotham
				Title.Text = labelText
				Title.TextColor3 = Theme.TextMain
				Title.TextSize = 13
				Title.TextXAlignment = Enum.TextXAlignment.Left
				Title.Parent = Holder

				local MinusBtn = Instance.new("TextButton")
				MinusBtn.Size = UDim2.fromOffset(12, 12)
				MinusBtn.Position = UDim2.fromOffset(5, 18)
				MinusBtn.BackgroundTransparency = 1
				MinusBtn.Font = Enum.Font.Code
				MinusBtn.Text = "-"
				MinusBtn.TextColor3 = Theme.TextDim
				MinusBtn.TextSize = 14
				MinusBtn.Parent = Holder

				local PlusBtn = Instance.new("TextButton")
				PlusBtn.Size = UDim2.fromOffset(12, 12)
				PlusBtn.Position = UDim2.new(1, -14, 0, 18)
				PlusBtn.BackgroundTransparency = 1
				PlusBtn.Font = Enum.Font.Code
				PlusBtn.Text = "+"
				PlusBtn.TextColor3 = Theme.TextDim
				PlusBtn.TextSize = 14
				PlusBtn.Parent = Holder

				local TrackOuter = Instance.new("TextButton")
				TrackOuter.Size = UDim2.new(1, -40, 0, 9)
				TrackOuter.Position = UDim2.fromOffset(22, 20)
				TrackOuter.BackgroundColor3 = Theme.OuterBlack
				TrackOuter.BorderSizePixel = 0
				TrackOuter.Text = ""
				TrackOuter.AutoButtonColor = false
				TrackOuter.Parent = Holder

				local TrackBg = Instance.new("Frame")
				TrackBg.Size = UDim2.new(1, -2, 1, -2)
				TrackBg.Position = UDim2.fromOffset(1, 1)
				TrackBg.BackgroundColor3 = Theme.ControlBg
				TrackBg.BorderSizePixel = 0
				TrackBg.Parent = TrackOuter

				local Fill = Instance.new("Frame")
				Fill.Size = UDim2.fromScale((value - minVal) / (maxVal - minVal), 1)
				Fill.BackgroundColor3 = Theme.Accent
				Fill.BorderSizePixel = 0
				Fill.Parent = TrackBg

				local FillGrad = Instance.new("UIGradient")
				FillGrad.Rotation = 90
				FillGrad.Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
					ColorSequenceKeypoint.new(1, Color3.fromRGB(185, 185, 185))
				})
				FillGrad.Parent = Fill

				local ValueText = Instance.new("TextLabel")
				ValueText.Size = UDim2.fromOffset(60, 14)
				ValueText.AnchorPoint = Vector2.new(0.5, 0.5)
				ValueText.Position = UDim2.new(1, 0, 1, 2)
				ValueText.BackgroundTransparency = 1
				ValueText.Font = Enum.Font.GothamBold
				ValueText.Text = tostring(value) .. suffix
				ValueText.TextColor3 = Color3.fromRGB(235, 235, 235)
				ValueText.TextStrokeColor3 = Theme.OuterBlack
				ValueText.TextStrokeTransparency = 0.05
				ValueText.TextSize = 12
				ValueText.ZIndex = 5
				ValueText.Parent = Fill

				local function SetSliderValue(newVal)
					value = math.clamp(math.round(newVal), minVal, maxVal)
					NullLibrary.Flags[flagId] = value
					local alpha = (value - minVal) / (maxVal - minVal)
					ValueText.Text = tostring(value) .. suffix
					Tween(Fill, TweenInfo.new(0.14, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Size = UDim2.fromScale(alpha, 1) })
					if callback then task.spawn(callback, value) end
				end

				local draggingSlider = false
				local function UpdateFromCursor(pos)
					local rel = math.clamp((pos.X - TrackBg.AbsolutePosition.X) / TrackBg.AbsoluteSize.X, 0, 1)
					SetSliderValue(minVal + (maxVal - minVal) * rel)
				end

				TrackOuter.MouseEnter:Connect(function() isHovered = true; Tween(TrackBg, TweenInfo.new(0.15), { BackgroundColor3 = Theme.ControlHover }) end)
				TrackOuter.MouseLeave:Connect(function() isHovered = false; Tween(TrackBg, TweenInfo.new(0.15), { BackgroundColor3 = Theme.ControlBg }) end)

				TrackOuter.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 then
						CloseActivePopups()
						isInteractingWithControl = true
						draggingSlider = true
						UpdateFromCursor(input.Position)
					end
				end)

				UserInputService.InputEnded:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 then draggingSlider = false end
				end)

				UserInputService.InputChanged:Connect(function(input)
					if draggingSlider and input.UserInputType == Enum.UserInputType.MouseMovement then
						UpdateFromCursor(input.Position)
					elseif isHovered and input.UserInputType == Enum.UserInputType.MouseWheel then
						SetSliderValue(value + (input.Position.Z > 0 and 1 or -1))
					end
				end)

				MinusBtn.MouseButton1Down:Connect(function() isInteractingWithControl = true end)
				PlusBtn.MouseButton1Down:Connect(function() isInteractingWithControl = true end)
				MinusBtn.MouseButton1Click:Connect(function() PlaySound(0.95); SetSliderValue(value - 1) end)
				PlusBtn.MouseButton1Click:Connect(function() PlaySound(1.05); SetSliderValue(value + 1) end)

				NullLibrary.Registry[flagId] = {
					Type = "Slider",
					Get = function() return value end,
					Set = function(val) SetSliderValue(tonumber(val) or defaultVal) end,
					Reset = function() SetSliderValue(defaultVal) end
				}
			end

			function GroupAPI:AddDropdown(flagId, labelText, options, defaultIndex, callback)
				local selected = options[defaultIndex or 1] or options[1]
				local isOpen = false
				NullLibrary.Flags[flagId] = selected

				local Holder = Instance.new("Frame")
				Holder.Size = UDim2.new(1, 0, 0, 42)
				Holder.BackgroundTransparency = 1
				Holder.Parent = ContentList

				local Title = Instance.new("TextLabel")
				Title.Size = UDim2.new(1, -22, 0, 15)
				Title.Position = UDim2.fromOffset(22, 0)
				Title.BackgroundTransparency = 1
				Title.Font = Enum.Font.Gotham
				Title.Text = labelText
				Title.TextColor3 = Theme.TextMain
				Title.TextSize = 13
				Title.TextXAlignment = Enum.TextXAlignment.Left
				Title.Parent = Holder

				local BoxOuter = Instance.new("TextButton")
				BoxOuter.Size = UDim2.new(1, -26, 0, 22)
				BoxOuter.Position = UDim2.fromOffset(22, 18)
				BoxOuter.BackgroundColor3 = Theme.OuterBlack
				BoxOuter.BorderSizePixel = 0
				BoxOuter.Text = ""
				BoxOuter.AutoButtonColor = false
				BoxOuter.Parent = Holder

				local BoxBg = Instance.new("Frame")
				BoxBg.Size = UDim2.new(1, -2, 1, -2)
				BoxBg.Position = UDim2.fromOffset(1, 1)
				BoxBg.BackgroundColor3 = Theme.ControlBg
				BoxBg.BorderSizePixel = 0
				BoxBg.Parent = BoxOuter

				local SelectedText = Instance.new("TextLabel")
				SelectedText.Size = UDim2.new(1, -24, 1, 0)
				SelectedText.Position = UDim2.fromOffset(8, 0)
				SelectedText.BackgroundTransparency = 1
				SelectedText.Font = Enum.Font.Gotham
				SelectedText.Text = selected
				SelectedText.TextColor3 = Theme.TextInactive
				SelectedText.TextSize = 12
				SelectedText.TextXAlignment = Enum.TextXAlignment.Left
				SelectedText.Parent = BoxBg

				local Arrow = Instance.new("TextLabel")
				Arrow.Size = UDim2.new(16, 20)
				Arrow.Position = UDim2.new(1, -18, 0, 0)
				Arrow.BackgroundTransparency = 1
				Arrow.Font = Enum.Font.Code
				Arrow.Text = "▼"
				Arrow.TextColor3 = Theme.TextDim
				Arrow.TextSize = 9
				Arrow.Parent = BoxBg

				local function SetDropdownValue(optName)
					selected = optName
					NullLibrary.Flags[flagId] = selected
					SelectedText.Text = selected
					if callback then task.spawn(callback, selected) end
				end

				BoxOuter.MouseButton1Down:Connect(function() isInteractingWithControl = true end)
				BoxOuter.MouseButton1Click:Connect(function()
					if isOpen then CloseActivePopups(); return end
					CloseActivePopups()
					PlaySound(1.15)
					isOpen = true
					Tween(Arrow, TweenInfo.new(0.18), { Rotation = 180 })

					local relPos = BoxOuter.AbsolutePosition - Interior.AbsolutePosition
					local boxWidth = BoxOuter.AbsoluteSize.X
					local targetHeight = #options * 22 + 2

					local FloatOuter = Instance.new("Frame")
					FloatOuter.Size = UDim2.fromOffset(boxWidth, 0)
					FloatOuter.Position = UDim2.fromOffset(relPos.X, relPos.Y + BoxOuter.AbsoluteSize.Y + 1)
					FloatOuter.BackgroundColor3 = Theme.OuterBlack
					FloatOuter.BorderSizePixel = 0
					FloatOuter.ClipsDescendants = true
					FloatOuter.ZIndex = 85
					FloatOuter.Parent = PopupLayer

					local FloatBg = Instance.new("Frame")
					FloatBg.Size = UDim2.new(1, -2, 1, -2)
					FloatBg.Position = UDim2.fromOffset(1, 1)
					FloatBg.BackgroundColor3 = Theme.ControlBg
					FloatBg.BorderSizePixel = 0
					FloatBg.ZIndex = 86
					FloatBg.Parent = FloatOuter

					local ListLayout = Instance.new("UIListLayout")
					ListLayout.SortOrder = Enum.SortOrder.LayoutOrder
					ListLayout.Parent = FloatBg

					for idx, optName in ipairs(options) do
						local OptBtn = Instance.new("TextButton")
						OptBtn.LayoutOrder = idx
						OptBtn.Size = UDim2.new(1, 0, 0, 22)
						OptBtn.BackgroundColor3 = Theme.ControlHover
						OptBtn.BackgroundTransparency = 1
						OptBtn.BorderSizePixel = 0
						OptBtn.Font = (optName == selected) and Enum.Font.GothamBold or Enum.Font.Gotham
						OptBtn.Text = "  " .. optName
						OptBtn.TextColor3 = (optName == selected) and Theme.Accent or Theme.TextMain
						OptBtn.TextSize = 12
						OptBtn.TextXAlignment = Enum.TextXAlignment.Left
						OptBtn.AutoButtonColor = false
						OptBtn.ZIndex = 87
						OptBtn.Parent = FloatBg

						OptBtn.MouseEnter:Connect(function() Tween(OptBtn, TweenInfo.new(0.12), { BackgroundTransparency = 0 }) end)
						OptBtn.MouseLeave:Connect(function() Tween(OptBtn, TweenInfo.new(0.12), { BackgroundTransparency = 1 }) end)
						OptBtn.MouseButton1Down:Connect(function() isInteractingWithControl = true end)
						OptBtn.MouseButton1Click:Connect(function()
							PlaySound(1.25)
							SetDropdownValue(optName)
							CloseActivePopups()
						end)
					end

					Tween(FloatOuter, TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { Size = UDim2.fromOffset(boxWidth, targetHeight) })
					ActivePopup = FloatOuter
					ActiveDropdownCloseCallback = function()
						isOpen = false
						Tween(Arrow, TweenInfo.new(0.18), { Rotation = 0 })
					end
				end)

				NullLibrary.Registry[flagId] = {
					Type = "Dropdown",
					Get = function() return selected end,
					Set = function(val) SetDropdownValue(val or options[defaultIndex or 1]) end,
					Reset = function() SetDropdownValue(options[defaultIndex or 1]) end
				}
			end

