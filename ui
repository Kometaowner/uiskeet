			ConfigTextBox.Parent = InputBg

			local ListBoxOuter = Instance.new("Frame")
			ListBoxOuter.Size = UDim2.new(1, -26, 0, 195)
			ListBoxOuter.Position = UDim2.fromOffset(22, 0)
			ListBoxOuter.BackgroundColor3 = Theme.OuterBlack
			ListBoxOuter.BorderSizePixel = 0
			ListBoxOuter.Parent = T3_ConfigGroup.Container

			local ListBoxBg = Instance.new("ScrollingFrame")
			ListBoxBg.Size = UDim2.new(1, -2, 1, -2)
			ListBoxBg.Position = UDim2.fromOffset(1, 1)
			ListBoxBg.BackgroundColor3 = Color3.fromRGB(16, 16, 16)
			ListBoxBg.BorderSizePixel = 0
			ListBoxBg.ScrollBarThickness = 3
			ListBoxBg.ScrollBarImageColor3 = Theme.Accent
			ListBoxBg.CanvasSize = UDim2.new(0, 0, 0, 0)
			ListBoxBg.AutomaticCanvasSize = Enum.AutomaticSize.Y
			ListBoxBg.Parent = ListBoxOuter

			local ConfigListLayout = Instance.new("UIListLayout")
			ConfigListLayout.SortOrder = Enum.SortOrder.LayoutOrder
			ConfigListLayout.Parent = ListBoxBg

			local SelectedConfigName = "default"
			_G.NullClientSavedConfigs = _G.NullClientSavedConfigs or {}

			local function CaptureCurrentState()
				local snapshot = {}
				for flagId, controller in pairs(NullLibrary.Registry) do
					snapshot[flagId] = controller.Get()
				end
				return snapshot
			end

			local function ApplyConfigSnapshot(snapshot)
				if not snapshot then return end
				for flagId, savedData in pairs(snapshot) do
					local controller = NullLibrary.Registry[flagId]
					if controller then controller.Set(savedData) end
				end
			end

			local function RefreshConfigListUI()
				for _, child in ipairs(ListBoxBg:GetChildren()) do
					if child:IsA("TextButton") then child:Destroy() end
				end
				local names = {}
				for cfgName, _ in pairs(NullLibrary.Configs) do table.insert(names, cfgName) end
				table.sort(names)

				for idx, cfgName in ipairs(names) do
					local isSel = (cfgName == SelectedConfigName)
					local RowBtn = Instance.new("TextButton")
					RowBtn.LayoutOrder = idx
					RowBtn.Size = UDim2.new(1, 0, 0, 24)
					RowBtn.BackgroundColor3 = Theme.ControlBg
					RowBtn.BackgroundTransparency = isSel and 0 or 1
					RowBtn.BorderSizePixel = 0
					RowBtn.Font = isSel and Enum.Font.GothamBold or Enum.Font.Gotham
					RowBtn.Text = "   " .. cfgName
					RowBtn.TextColor3 = isSel and Theme.Accent or Theme.TextMain
					RowBtn.TextSize = 12
					RowBtn.TextXAlignment = Enum.TextXAlignment.Left
					RowBtn.AutoButtonColor = false
					RowBtn.Parent = ListBoxBg

					RowBtn.MouseButton1Down:Connect(function() isInteractingWithControl = true end)
					RowBtn.MouseButton1Click:Connect(function()
						PlaySound(1.15)
						SelectedConfigName = cfgName
						ConfigTextBox.Text = cfgName
						RefreshConfigListUI()
					end)
				end
			end

			NullLibrary.Configs["default"] = CaptureCurrentState()
			NullLibrary.Configs["legit"] = CaptureCurrentState()
			NullLibrary.Configs["rage"] = CaptureCurrentState()
			for k, v in pairs(_G.NullClientSavedConfigs) do NullLibrary.Configs[k] = v end
			RefreshConfigListUI()

			T3_ConfigGroup:AddButton("Create / Save Config", Theme.Accent, function()
				local name = ConfigTextBox.Text:gsub("^%s*(.-)%s*$", "%1")
				if name == "" then NullLibrary:Notify("Config Error", "Enter a valid preset name!"); return end
				local data = CaptureCurrentState()
				NullLibrary.Configs[name] = data
				_G.NullClientSavedConfigs[name] = data
				SelectedConfigName = name
				pcall(function() if writefile then writefile("NullClient_" .. name .. ".json", HttpService:JSONEncode(data)) end end)
				RefreshConfigListUI()
				NullLibrary:Notify("Configuration Saved", string.format("Preset '%s' saved.", name))
			end)

			T3_ConfigGroup:AddButton("Load Selected Config", Theme.TextMain, function()
				local snapshot = NullLibrary.Configs[SelectedConfigName]
				if not snapshot then NullLibrary:Notify("Load Error", "Preset not found!"); return end
				ApplyConfigSnapshot(snapshot)
				NullLibrary:Notify("Configuration Loaded", string.format("Loaded preset '%s'.", SelectedConfigName))
			end)

			T3_ConfigGroup:AddButton("Delete Selected Config", Theme.Danger, function()
				if SelectedConfigName == "default" then NullLibrary:Notify("Protected", "Cannot delete 'default'."); return end
				local removed = SelectedConfigName
				NullLibrary.Configs[removed] = nil
				_G.NullClientSavedConfigs[removed] = nil
				SelectedConfigName = "default"
				ConfigTextBox.Text = "default"
				RefreshConfigListUI()
				NullLibrary:Notify("Configuration Deleted", string.format("Removed '%s'.", removed))
			end)

			T3_ConfigGroup:AddButton("Reset All to Default", Theme.TextInactive, function()
				for _, controller in pairs(NullLibrary.Registry) do controller.Reset() end
				NullLibrary:Notify("Reset Complete", "All settings restored.")
			end)

			T3_ConfigGroup:AddButton("Export JSON to Clipboard", Theme.TextMain, function()
				local json = HttpService:JSONEncode(CaptureCurrentState())
				pcall(function() if setclipboard then setclipboard(json) end end)
				NullLibrary:Notify("Config Exported", "Copied JSON (" .. tostring(#json) .. " bytes).")
			end)

			T3_MenuGroup:AddToggle("UI_ShowWatermark", "Show Watermark Bar", true, nil, function(state)
				Tween(WatermarkCanvas, TweenInfo.new(0.28), { GroupTransparency = state and 0 or 1 })
				task.delay(0.28, function() WatermarkCanvas.Visible = state end)
				if state then WatermarkCanvas.Visible = true end
			end)

			T3_MenuGroup:AddToggle("UI_ShowHotkeys", "Show Hotkeys Widget", true, nil, function(state)
				Tween(HotkeysWidget, TweenInfo.new(0.28), { GroupTransparency = state and 0 or 1 })
				task.delay(0.28, function() HotkeysWidget.Visible = state end)
				if state then HotkeysWidget.Visible = true end
			end)

			T3_MenuGroup:AddToggle("UI_MenuSounds", "Interface Click Sounds", true, nil, function(state)
				NullLibrary.SoundEnabled = state
			end)

			T3_MenuGroup:AddSlider("UI_Scale", "Menu Scale", 75, 115, 100, "%", function(val)
				userScaleFactor = val / 100
				if isMenuOpen then
					Tween(WindowScale, TweenInfo.new(0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Scale = userScaleFactor })
				end
			end)

			T3_MenuGroup:AddDropdown("UI_MenuKey", "Menu Toggle Key", { "Insert", "RightShift", "Home", "End" }, 1, function(selectedKey)
				if Enum.KeyCode[selectedKey] then NullLibrary.MenuKey = Enum.KeyCode[selectedKey] end
			end)
		end

		return TabObject
	end

	PlayIntro(function()
		Tween(WatermarkCanvas, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { GroupTransparency = 0 })
		Tween(HotkeysWidget, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { GroupTransparency = 0 })
