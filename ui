			WindowScale.Scale = userScaleFactor * 0.96
			Tween(WindowScale, menuFadeInfo, { Scale = userScaleFactor })
			local tw = Tween(MainCanvas, menuFadeInfo, { GroupTransparency = 0 })
			tw.Completed:Wait()
		else
			Tween(WindowScale, menuFadeInfo, { Scale = userScaleFactor * 0.96 })
			local tw = Tween(MainCanvas, menuFadeInfo, { GroupTransparency = 1 })
			tw.Completed:Wait()
			MainCanvas.Visible = false
