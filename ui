					Size = UDim2.new(1, 0, 0, 0),
					BackgroundTransparency = 1
				})
				RecalculateHotkeysHeight()
				task.delay(0.23, function()
					if existing.Row then existing.Row:Destroy() end
					HotkeyRows[id] = nil
				end)
			end
			return
		end

