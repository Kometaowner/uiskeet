				ValueText.BackgroundTransparency = 1
				ValueText.Font = Enum.Font.GothamBold
				ValueText.Text = tostring(value) .. suffix
				ValueText.TextColor3 = Color3.fromRGB(235, 235, 235)
				ValueText.TextStrokeColor3 = Theme.OuterBlack
				ValueText.TextStrokeTransparency = 0.05
				ValueText.TextSize = 12
				ValueText.ZIndex = 5
				ValueText.Parent = Fill

				local function SetSliderValue(newVal)
					value = math.clamp(math.round(newVal), minVal, maxVal)
					NullLibrary.Flags[flagId] = value
					local alpha = (value - minVal) / (maxVal - minVal)
					ValueText.Text = tostring(value) .. suffix
					Tween(Fill, TweenInfo.new(0.14, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Size = UDim2.fromScale(alpha, 1) })
					if callback then task.spawn(callback, value) end
				end

				local draggingSlider = false
				local function UpdateFromCursor(pos)
					local rel = math.clamp((pos.X - TrackBg.AbsolutePosition.X) / TrackBg.AbsoluteSize.X, 0, 1)
					SetSliderValue(minVal + (maxVal - minVal) * rel)
				end

				TrackOuter.MouseEnter:Connect(function() isHovered = true; Tween(TrackBg, TweenInfo.new(0.15), { BackgroundColor3 = Theme.ControlHover }) end)
				TrackOuter.MouseLeave:Connect(function() isHovered = false; Tween(TrackBg, TweenInfo.new(0.15), { BackgroundColor3 = Theme.ControlBg }) end)

				TrackOuter.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 then
						CloseActivePopups()
						isInteractingWithControl = true
						draggingSlider = true
						UpdateFromCursor(input.Position)
					end
				end)

				UserInputService.InputEnded:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 then draggingSlider = false end
				end)

				UserInputService.InputChanged:Connect(function(input)
					if draggingSlider and input.UserInputType == Enum.UserInputType.MouseMovement then
						UpdateFromCursor(input.Position)
					elseif isHovered and input.UserInputType == Enum.UserInputType.MouseWheel then
						SetSliderValue(value + (input.Position.Z > 0 and 1 or -1))
					end
				end)

				MinusBtn.MouseButton1Down:Connect(function() isInteractingWithControl = true end)
				PlusBtn.MouseButton1Down:Connect(function() isInteractingWithControl = true end)
				MinusBtn.MouseButton1Click:Connect(function() PlaySound(0.95); SetSliderValue(value - 1) end)
				PlusBtn.MouseButton1Click:Connect(function() PlaySound(1.05); SetSliderValue(value + 1) end)

				NullLibrary.Registry[flagId] = {
					Type = "Slider",
					Get = function() return value end,
					Set = function(val) SetSliderValue(tonumber(val) or defaultVal) end,
					Reset = function() SetSliderValue(defaultVal) end
				}
			end

