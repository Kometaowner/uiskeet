				ClickZone.BackgroundTransparency = 1
				ClickZone.Text = ""
				ClickZone.AutoButtonColor = false
				ClickZone.Parent = Row

				local CheckOuter = Instance.new("Frame")
				CheckOuter.Size = UDim2.fromOffset(11, 11)
				CheckOuter.AnchorPoint = Vector2.new(0, 0.5)
				CheckOuter.Position = UDim2.new(0, 0, 0.5, 0)
				CheckOuter.BackgroundColor3 = Theme.OuterBlack
				CheckOuter.BorderSizePixel = 0
				CheckOuter.Parent = ClickZone

				local CheckFill = Instance.new("Frame")
				CheckFill.Size = UDim2.new(1, -2, 1, -2)
				CheckFill.Position = UDim2.fromOffset(1, 1)
				CheckFill.BackgroundColor3 = state and Theme.Accent or Theme.ControlBg
				CheckFill.BorderSizePixel = 0
				CheckFill.Parent = CheckOuter

				local CheckGrad = Instance.new("UIGradient")
				CheckGrad.Rotation = 90
				CheckGrad.Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
					ColorSequenceKeypoint.new(1, Color3.fromRGB(185, 185, 185))
				})
				CheckGrad.Parent = CheckFill

				local Title = Instance.new("TextLabel")
				Title.Size = UDim2.new(1, -24, 1, 0)
				Title.Position = UDim2.fromOffset(22, 0)
				Title.BackgroundTransparency = 1
				Title.Font = Enum.Font.Gotham
				Title.Text = labelText
				Title.TextColor3 = state and Theme.TextMain or Theme.TextInactive
				Title.TextSize = 13
				Title.TextXAlignment = Enum.TextXAlignment.Left
				Title.Parent = ClickZone

				local BindBtn = Instance.new("TextButton")
				BindBtn.Size = UDim2.fromOffset(42, 20)
				BindBtn.Position = UDim2.new(1, -42, 0, 0)
				BindBtn.BackgroundTransparency = 1
				BindBtn.Font = Enum.Font.Code
				BindBtn.Text = boundKey and ("[" .. boundKey.Name:upper():sub(1, 3) .. "]") or "[-]"
				BindBtn.TextColor3 = Theme.TextDim
				BindBtn.TextSize = 12
				BindBtn.TextXAlignment = Enum.TextXAlignment.Right
				BindBtn.AutoButtonColor = false
				BindBtn.Parent = Row

				local function SyncToHotkeys()
					local hasBind = (boundKey ~= nil)
					local shortKey = boundKey and boundKey.Name:upper():sub(1, 3) or nil
					UpdateHotkeyItem(flagId, labelText, state, shortKey, hasBind)
				end

				local function SetState(newState, silent)
					state = newState
					NullLibrary.Flags[flagId] = state
					if not silent then PlaySound(state and 1.35 or 0.85) end
					CheckOuter.Size = UDim2.fromOffset(8, 8)
					Tween(CheckOuter, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = UDim2.fromOffset(11, 11) })
					Tween(CheckFill, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundColor3 = state and Theme.Accent or Theme.ControlBg })
					Tween(Title, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { TextColor3 = state and Theme.TextMain or Theme.TextInactive })
					SyncToHotkeys()
					if callback then task.spawn(callback, state) end
				end

				local function SetBind(newKeyCode, newMode)
					boundKey = newKeyCode
					bindMode = newMode or bindMode
					BindBtn.Text = boundKey and ("[" .. boundKey.Name:upper():sub(1, 3) .. "]") or "[-]"
					SyncToHotkeys()
				end

				if boundKey then SyncToHotkeys() end

				ClickZone.MouseButton1Down:Connect(function() isInteractingWithControl = true end)
				ClickZone.MouseButton1Click:Connect(function() CloseActivePopups(); SetState(not state, false) end)

				BindBtn.MouseButton1Down:Connect(function() isInteractingWithControl = true end)
				BindBtn.MouseButton1Click:Connect(function()
					CloseActivePopups()
					PlaySound(1.1)
					listeningForKey = true
					BindBtn.Text = "[...]"
					BindBtn.TextColor3 = Theme.Accent
				end)

				BindBtn.MouseButton2Click:Connect(function()
					OpenBindModePopup(BindBtn, bindMode, function(selectedMode)
						bindMode = selectedMode
						if bindMode == "Always on" then SetState(true, false) end
					end)
				end)

				UserInputService.InputBegan:Connect(function(input, gp)
					if listeningForKey then
						if input.UserInputType == Enum.UserInputType.Keyboard then
							if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.Backspace then
								SetBind(nil, bindMode)
							else
								SetBind(input.KeyCode, bindMode)
							end
							BindBtn.TextColor3 = Theme.TextDim
							listeningForKey = false
						end
					elseif not gp and boundKey and input.KeyCode == boundKey then
						if bindMode == "Toggle" then SetState(not state, false)
						elseif bindMode == "On hotkey" then SetState(true, false)
						elseif bindMode == "Off hotkey" then SetState(false, false) end
					end
				end)

				UserInputService.InputEnded:Connect(function(input, gp)
					if not gp and boundKey and input.KeyCode == boundKey then
						if bindMode == "On hotkey" then SetState(false, true)
						elseif bindMode == "Off hotkey" then SetState(true, true) end
					end
				end)

				NullLibrary.Registry[flagId] = {
					Type = "Toggle",
					Get = function() return { State = state, Key = boundKey and boundKey.Name or nil, Mode = bindMode } end,
					Set = function(data) SetBind(data.Key and Enum.KeyCode[data.Key] or nil, data.Mode or "Toggle"); SetState(data.State == true, true) end,
					Reset = function() SetBind(defaultKey, "Toggle"); SetState(defaultState or false, true) end
				}
			end

