	local function RecalculateHotkeysHeight()
		local activeCount = 0
		for _, data in pairs(HotkeyRows) do
			if not data.removing then activeCount += 1 end
		end
		HkCountBadge.Text = "[" .. tostring(activeCount) .. "]"
		HkCountBadge.TextColor3 = (activeCount > 0) and Theme.Accent or Theme.TextDim

		local targetH = 34 + (activeCount > 0 and (activeCount * 31 + 4) or 0)
		Tween(HotkeysWidget, TweenInfo.new(0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
			Size = UDim2.fromOffset(205, targetH)
		})
	end

	local function UpdateHotkeyItem(id, displayName, state, keyName, shouldDisplay)
