	local function Tween(obj, info, props)
		local tw = TweenService:Create(obj, info, props)
		tw:Play()
		return tw
	end

	local function PlaySound(pitch, volume)
		if not NullLibrary.SoundEnabled then return end
		local s = Instance.new("Sound")
		s.SoundId = "rbxassetid://" .. Assets.ClickSound
		s.Volume = volume or 0.35
		s.PlaybackSpeed = pitch or 1.0
		s.Parent = SoundService
		s:Play()
		s.Ended:Connect(function() s:Destroy() end)
	end

	local function ApplySmartImage(imageLabel, rawId, isTabIcon)
		local cleanId = tostring(rawId):gsub("%D", "")
		local directUrl = "rbxassetid://" .. cleanId
		local thumbUrl = string.format("rbxthumb://type=Asset&id=%s&w=420&h=420", cleanId)

		imageLabel.Image = thumbUrl
		if isTabIcon then
			imageLabel.ImageRectOffset = Vector2.new(65, 65)
			imageLabel.ImageRectSize = Vector2.new(290, 290)
		else
			imageLabel.ImageRectOffset = Vector2.zero
			imageLabel.ImageRectSize = Vector2.zero
		end

		task.spawn(function()
			pcall(function() ContentProvider:PreloadAsync({ imageLabel }) end)
			task.wait(0.35)
			if not imageLabel.IsLoaded then
				imageLabel.ImageRectOffset = Vector2.zero
				imageLabel.ImageRectSize = Vector2.zero
				imageLabel.Image = directUrl
			end
		end)
	end

	local function CreateInnerBorder(parent, color, zIndex)
		local holder = Instance.new("Folder")
		holder.Name = "PixelBorder"
		holder.Parent = parent

		local function makeEdge(size, pos, anchor)
			local f = Instance.new("Frame")
			f.Size = size
			f.Position = pos
			f.AnchorPoint = anchor or Vector2.zero
			f.BackgroundColor3 = color
			f.BorderSizePixel = 0
			if zIndex then f.ZIndex = zIndex end
			f.Parent = holder
			return f
		end

		makeEdge(UDim2.new(1, 0, 0, 1), UDim2.new(0, 0, 0, 0))
		makeEdge(UDim2.new(1, 0, 0, 1), UDim2.new(0, 0, 1, 0), Vector2.new(0, 1))
		makeEdge(UDim2.new(0, 1, 1, 0), UDim2.new(0, 0, 0, 0))
		makeEdge(UDim2.new(0, 1, 1, 0), UDim2.new(1, 0, 0, 0), Vector2.new(1, 0))
		return holder
	end

